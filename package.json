{
  "name": "playlistify",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "predev": "npm run check:node",
    "dev": "next dev",
    "prebuild": "npm run check:node",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "gen:types": "node --env-file=.env.local scripts/gen-types.mjs",
    "verify:rls": "node --env-file=.env.local scripts/verify-rls.mjs",
    "verify:import": "node --env-file=.env.local scripts/verify-import.mjs",
    "verify:enrichment": "node --env-file=.env.local scripts/verify-enrichment.mjs",
    "verify:re-enrichment": "node --env-file=.env.local --import tsx scripts/verify-re-enrichment.mts",
    "verify:genres": "node --env-file=.env.local --import tsx scripts/verify-genres.mts",
    "verify:chat-prompt": "node --env-file=.env.local --import tsx scripts/verify-chat-prompt.mts",
    "verify:playlists": "node --env-file=.env.local --import tsx scripts/verify-playlists.mts",
    "verify:tokens": "node --env-file=.env.local scripts/check-tokens.mjs",
    "verify:refresh": "node --env-file=.env.local --import tsx scripts/exercise-refresh.mts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.18",
    "@ai-sdk/react": "^4.0.40",
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "ai": "^7.0.35",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "supabase": "2.113.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0"
  }
}
