# ── Supabase ─────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API (use the anon + service_role JWT keys;
# they may be under a "Legacy API keys" tab in newer dashboards).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Spotify app ──────────────────────────────────────────────────────────
# developer.spotify.com/dashboard → your app → Settings. Used server-side by
# the token-refresh helper (Supabase never refreshes provider tokens).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── OpenAI ───────────────────────────────────────────────────────────────
# Used server-side by the enrichment pipeline and the chat step.
OPENAI_API_KEY=

# ── Chat model ───────────────────────────────────────────────────────────
# The conversational playlist model, as `provider:model_id` (provider must be
# mapped in lib/ai/providers.ts and its API key set above). Optional — unset
# falls back to the DEFAULT_CHAT_MODEL in lib/ai/chat-model.ts. Unlike
# enrichment, chat does NOT read the llm_models table.
# CHAT_MODEL=openai:gpt-5.4

# ── Enrichment cost guardrails ───────────────────────────────────────────
# Optional; a malformed or empty value falls back to the default. Neither the
# model nor how it is asked to work is an env var — provider, model, reasoning
# effort, and songs per LLM call all come from the enrichment_recipes row the
# database selects, so they stay recorded against the attempts they shaped.
# Ceiling per click of Analyze & improve (clamped 1-5000, default 500). It
# counts analyses, not distinct songs: a song analyzed three times spends
# three of them. Reaching it pauses the run; nothing queued is lost.
ENRICHMENT_MAX_SONGS_PER_RUN=

# ── Local CLI tooling only (never deploy these) ──────────────────────────
# Access token: supabase.com dashboard → Account → Access Tokens.
# DB password: shown once when the project is created.
# Used by `npx supabase link` / `npx supabase db push`.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
